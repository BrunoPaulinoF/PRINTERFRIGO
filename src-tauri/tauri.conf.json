{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrinterFrigo",
  "version": "0.5.13",
  "identifier": "br.com.kyberfrigo.printerfrigo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PrinterFrigo",
        "width": 500,
        "height": 760,
        "minWidth": 420,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1RTY0RDhFMzFFRTY0NzUKUldSMVpPNHhqazNtSldmQnhFNkdBZmRNSXRaQmEyc0FXWDlwWTBGazdqa2FZaGY2cHpNZllSZzIK",
      "endpoints": [
        "https://github.com/BrunoPaulinoF/PRINTERFRIGO/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
